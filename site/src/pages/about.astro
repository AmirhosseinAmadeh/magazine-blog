---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PixelLogo from '../components/PixelLogo.astro';
import { faNumber } from '../lib/utils';

const issues = await getCollection('issues');
const pages = issues.reduce((s, i) => s + i.data.pages, 0);
---

<Base title="درباره">
  <div class="page-narrow">
    <PixelLogo class="about-logo" />
    <h1 class="page-title">درباره‌ی پیکسل</h1>
    <p class="lead">
      پیکسل نشریه‌ی انجمن علمی دانشکده‌ی مهندسی کامپیوتر دانشگاه شهید بهشتی است؛ گاهنامه‌ای که هر چند ماه یک‌بار با مطلب‌های دانشجویی،
      مصاحبه با اساتید، معرفی بازی و کتاب و یک معما بیرون می‌آید.
    </p>
    <p>
      تا امروز {faNumber(issues.length)} شماره و {faNumber(pages)} صفحه منتشر شده است. این سایت آرشیو همه‌ی شماره‌هاست: می‌توانید
      هر شماره را همین‌جا ورق بزنید، به صفحه‌ی یک مطلب مشخص بروید یا PDF آن را دانلود کنید.
    </p>
    <h2>هر شماره چه دارد؟</h2>
    <ul class="plain">
      <li>سخن سردبیر و دورنما (فهرست مطالب)</li>
      <li>مصاحبه با یکی از اساتید یا پیشکسوتان</li>
      <li>مطلب‌های فنی: هوش مصنوعی، رباتیک، داده و الگوریتم، وب و بازی‌سازی</li>
      <li>اخبار دانشکده، معرفی کتاب و تئاتر، و معما</li>
    </ul>
    <h2>حق نشر</h2>
    <p class="muted">مالکیت هر مطلب با نویسنده‌اش است. شرایط بازنشر هنوز مشخص نشده است.</p>
  </div>
</Base>
