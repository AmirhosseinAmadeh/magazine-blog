---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PixelLogo from '../components/PixelLogo.astro';
import PixelIcon from '../components/PixelIcon.astro';
import IssueCover from '../components/IssueCover.astro';
import Toc from '../components/Toc.astro';
import { KINDS } from '../lib/pixel';
import { faNumber, issueLabel, pdfInfo, readUrl, sortIssues, url } from '../lib/utils';

const issues = sortIssues(await getCollection('issues'));
const latest = issues[0];

const all = issues.flatMap((i) => i.data.toc);
const totalPages = issues.reduce((s, i) => s + i.data.pages, 0);
const kindCount = Object.entries(
  all.filter((e) => e.kind !== 'editorial').reduce<Record<string, number>>((m, e) => ((m[e.kind] = (m[e.kind] ?? 0) + 1), m), {}),
).sort((a, b) => b[1] - a[1]);
const ticker = [...new Set(all.map((e) => e.title))].filter((t) => t !== 'معما' && t !== 'سخن سردبیر').slice(0, 40);
const pdf = latest ? pdfInfo(latest) : null;
---

<Base>
  {
    !latest ? (
      <section class="empty">
        <PixelLogo />
        <p>هنوز شماره‌ای منتشر نشده است.</p>
      </section>
    ) : (
      <>
        <section class="hero full-bleed">
          <div class="hero-bands" aria-hidden="true"></div>
          <div class="wrap hero-grid">
            <div class="hero-panel px">
              <PixelLogo animate class="hero-logo" />
              <p class="hero-sub">نشریه‌ی انجمن علمی دانشکده‌ی مهندسی کامپیوتر<br />دانشگاه شهید بهشتی</p>
              <p class="hero-issue">
                <span class="tag">{issueLabel(latest)}</span>
                <span class="cursor">{latest.data.date}</span>
              </p>
              <div class="actions">
                <a class="btn" href={readUrl(latest)}>بخوان</a>
                {pdf && (
                  <a class="btn ghost" href={pdf.url} download>
                    دانلود PDF <small>({pdf.mb} مگ)</small>
                  </a>
                )}
                <a class="btn ghost" href={url('/archive')}>همه‌ی شماره‌ها</a>
              </div>
            </div>
            <a class="hero-cover" href={url(`/issues/${latest.id}`)} aria-label={`صفحه‌ی ${issueLabel(latest)}`}>
              <IssueCover issue={latest} reveal eager />
            </a>
          </div>
        </section>

        <div class="ticker full-bleed" aria-hidden="true">
          <div class="ticker-track">
            {[0, 1].map(() => ticker.map((t) => <span>{t}</span>))}
          </div>
        </div>

        <div class="section-head" data-px>
          <h2>دورنما <small>{issueLabel(latest)}</small></h2>
          <a href={url(`/issues/${latest.id}`)}>صفحه‌ی شماره ←</a>
        </div>
        <Toc issue={latest} />

        <div class="section-head" data-px>
          <h2>قفسه‌ی شماره‌ها</h2>
          <a href={url('/archive')}>آرشیو و فهرست مطالب ←</a>
        </div>
        <div class="shelf">
          {
            issues.map((i) => (
              <a href={url(`/issues/${i.id}`)} class="shelf-item" data-px>
                <IssueCover issue={i} small />
                <span class="shelf-cap">
                  <b>{issueLabel(i)}</b>
                  <small>{i.data.date}</small>
                </span>
              </a>
            ))
          }
        </div>

        <div class="section-head" data-px><h2>ستون‌های ثابت</h2></div>
        <ul class="kinds">
          {
            kindCount.map(([k, n]) => (
              <li data-px>
                <a class="kind px" href={url(`/archive#kind=${k}`)}>
                  <PixelIcon name={k} />
                  <span class="kind-name">{KINDS[k]}</span>
                  <span class="kind-n" data-count={n}>{faNumber(n)}</span>
                </a>
              </li>
            ))
          }
        </ul>

        <section class="stats" data-px>
          {
            [
              [issues.length, 'شماره'],
              [totalPages, 'صفحه'],
              [all.length, 'مطلب'],
              [all.filter((e) => e.kind === 'interview').length, 'مصاحبه'],
            ].map(([n, label]) => (
              <div>
                <b data-count={n}>{faNumber(n as number)}</b>
                <span>{label}</span>
              </div>
            ))
          }
        </section>

        <section class="cta px" data-px>
          <h2>برای پیکسل بنویس</h2>
          <p>درباره‌ی چیزی که می‌دانی، می‌سازی یا کنجکاوش هستی. مطلبت می‌تواند در شماره‌ی بعد باشد.</p>
          <a class="btn" href={url('/write')}>راهنمای نویسندگان</a>
        </section>
      </>
    )
  }
</Base>

<script>
  // Scroll reveal: every [data-px] block is veiled by a grid of squares that dissolves in random
  // order when it scrolls into view (same effect as the cover), and [data-count] numbers count up from 0.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fa = (n: number) => n.toLocaleString('fa-IR');

  function countUp(el: HTMLElement, delay: number) {
    const to = Number(el.dataset.count);
    if (!Number.isFinite(to)) return;
    const dur = 1500;
    const t0 = performance.now() + delay;
    const tick = (now: number) => {
      const k = Math.min(1, Math.max(0, (now - t0) / dur));
      el.textContent = fa(Math.round(to * (1 - Math.pow(1 - k, 3))));
      if (k < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  function veil(el: HTMLElement) {
    const r = el.getBoundingClientRect();
    const size = Math.max(14, Math.sqrt((r.width * r.height) / 360));
    const cols = Math.max(1, Math.ceil(r.width / size));
    const rows = Math.max(1, Math.ceil(r.height / size));
    const v = document.createElement('div');
    v.className = 'px-veil';
    v.setAttribute('aria-hidden', 'true');
    v.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
    v.style.gridTemplateRows = `repeat(${rows}, 1fr)`;
    v.innerHTML = Array.from({ length: cols * rows }, () => `<i style="--cd:${Math.round(Math.random() * 650)}ms"></i>`).join('');
    el.classList.add('px-host');
    el.append(v);
    return v;
  }

  const items = [...document.querySelectorAll<HTMLElement>('[data-px]')];
  const counters = (el: HTMLElement) => [...el.querySelectorAll<HTMLElement>('[data-count]')];

  if (reduce || !('IntersectionObserver' in window)) {
    // numbers already hold their final value in the HTML
  } else {
    const veils = new Map<HTMLElement, HTMLElement>();
    items.forEach((el) => {
      veils.set(el, veil(el));
      counters(el).forEach((c) => (c.textContent = fa(0)));
    });
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          io.unobserve(el);
          const idx = [...(el.parentElement?.children ?? [])].filter((s) => s.hasAttribute('data-px')).indexOf(el);
          const d = Math.min(idx, 8) * 70;
          const v = veils.get(el)!;
          v.style.setProperty('--d', `${d}ms`);
          v.classList.add('go');
          // veil cells vanish within 650ms (+80ms fade) after the stagger delay; count only once they're gone
          counters(el).forEach((c) => countUp(c, d + 750));
          setTimeout(() => v.remove(), d + 1000);
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );
    items.forEach((el) => io.observe(el));
  }
</script>
